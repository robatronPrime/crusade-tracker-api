{
    "name": "server",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "start": "node index.mjs",
        "test": "node --test",
        "lint": "eslint .",
        "format": "prettier --single-quote --check .",
        "prepare": "cd ../ && husky install server/.husky",
        "dev": "nodemon --experimental-modules --watch .env --ext js,mjs,cjs,json,env index.mjs"
    },
    "dependencies": {
        "@clerk/backend": "^3.17.1",
        "cors": "^2.8.5",
        "dotenv": "^8.2.0",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "mongodb": "^4.13.0",
        "mongoose": "^8.15.0"
    },
    "devDependencies": {
        "eslint": "^8.0.0",
        "husky": "^7.0.2",
        "lint-staged": "^11.2.3",
        "nodemon": "^3.1.9",
        "prettier": "^2.4.1"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.js": [
            "prettier --single-quote --write",
            "eslint --fix"
        ]
    }
}
